{
    "crons": [
        {
            "path": "/api/notifications/check-due",
            "schedule": "*/15 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
